{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature DAG deterministic conversation protocol 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "current_stage", "stages", "next_request"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "current_stage": {
      "enum": ["SYNTAX_INTAKE", "BASE_DISCOVERY", "BASE_COMPLETION", "DERIVED_COMPLETION", "FINAL_VALIDATION", "VERDICT"]
    },
    "stages": {"$ref": "#/$defs/stages"},
    "next_request": {"$ref": "#/$defs/nextRequest"}
  },
  "allOf": [
    {
      "if": {"properties": {"current_stage": {"const": "VERDICT"}}},
      "then": {"properties": {"stages": {"properties": {
        "final_validation": {"properties": {"status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}, "mode": {"enum": ["REMOTE", "RULE_FALLBACK"]}}},
        "verdict": {"properties": {"status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}, "value": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}}}
      }}}}
    },
    {
      "if": {"properties": {"current_stage": {"not": {"const": "VERDICT"}}}},
      "then": {"properties": {"stages": {"properties": {
        "verdict": {"properties": {"status": {"const": "SKIPPED"}, "value": {"type": "null"}, "boundary": {"type": "null"}}}
      }}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"enum": ["EXPRESSION_INPUT", "SYNTAX_CORRECTION"]}}}}},
      "then": {"properties": {"current_stage": {"const": "SYNTAX_INTAKE"}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"enum": ["BASE_METADATA", "CONFLICT_CORRECTION"]}}}}},
      "then": {"properties": {"current_stage": {"const": "BASE_COMPLETION"}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"enum": ["DERIVED_NAME", "OPERATOR_CONTRACT", "DERIVED_METADATA"]}}}}},
      "then": {"properties": {"current_stage": {"const": "DERIVED_COMPLETION"}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"const": "MODEL_WRAPPER"}}}}},
      "then": {"properties": {"current_stage": {"const": "FINAL_VALIDATION"}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"const": "MODEL_CORRECTION"}}}}},
      "then": {"properties": {"current_stage": {"const": "VERDICT"}, "stages": {"properties": {"verdict": {"properties": {"status": {"const": "FAIL"}, "value": {"const": "FAIL"}}}}}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"const": "NONE"}}}}},
      "then": {"properties": {"current_stage": {"const": "VERDICT"}, "stages": {"properties": {"verdict": {"properties": {"status": {"const": "PASS"}, "value": {"const": "PASS"}}}}}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"const": "EXPRESSION_INPUT"}}}}},
      "then": {"properties": {"stages": {"properties": {"syntax_intake": {"properties": {"status": {"const": "PENDING"}, "original_input": {"type": "null"}, "normalized_input": {"type": "null"}}}}}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"const": "SYNTAX_CORRECTION"}}}}},
      "then": {"properties": {"stages": {"properties": {"syntax_intake": {"properties": {"status": {"const": "FAIL"}}}}}}}
    },
    {
      "if": {"properties": {"next_request": {"properties": {"request_type": {"enum": ["EXPRESSION_INPUT", "SYNTAX_CORRECTION"]}}}}},
      "then": {"properties": {"stages": {"properties": {
        "base_discovery": {"properties": {"status": {"const": "SKIPPED"}}},
        "base_completion": {"properties": {"status": {"const": "SKIPPED"}}},
        "derived_completion": {"properties": {"status": {"const": "SKIPPED"}}},
        "final_validation": {"properties": {"status": {"const": "SKIPPED"}, "mode": {"const": "NOT_RUN"}}}
      }}}}
    },
    {
      "if": {"properties": {"stages": {"properties": {"final_validation": {"properties": {"status": {"const": "PASS"}}}}}}},
      "then": {"properties": {"stages": {"properties": {"verdict": {"properties": {"status": {"const": "PASS"}, "value": {"const": "PASS"}}}}}}}
    },
    {
      "if": {"properties": {"stages": {"properties": {"final_validation": {"properties": {"status": {"const": "FAIL"}}}}}}},
      "then": {"properties": {"stages": {"properties": {"verdict": {"properties": {"status": {"const": "FAIL"}, "value": {"const": "FAIL"}}}}}}}
    },
    {
      "if": {"properties": {"stages": {"properties": {"final_validation": {"properties": {"status": {"const": "INCOMPLETE"}}}}}}},
      "then": {"properties": {"stages": {"properties": {"verdict": {"properties": {"status": {"const": "INCOMPLETE"}, "value": {"const": "INCOMPLETE"}}}}}}}
    },
    {
      "if": {"properties": {"stages": {"properties": {"final_validation": {"properties": {"mode": {"const": "REMOTE"}}}}}}},
      "then": {"properties": {"stages": {"properties": {"verdict": {"properties": {"boundary": {"const": "REMOTE_VALIDATOR_RESULT"}}}}}}}
    },
    {
      "if": {"properties": {"stages": {"properties": {"final_validation": {"properties": {"mode": {"const": "RULE_FALLBACK"}}}}}}},
      "then": {"properties": {"stages": {"properties": {"verdict": {"properties": {"boundary": {"const": "RULE_VALIDATION_ONLY"}}}}}}}
    }
  ],
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "PENDING", "INCOMPLETE", "SKIPPED"]},
    "nullableString": {"type": ["string", "null"]},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "feature_name", "field", "offset", "message"],
      "properties": {
        "code": {"type": "string"},
        "feature_name": {"$ref": "#/$defs/nullableString"},
        "field": {"$ref": "#/$defs/nullableString"},
        "offset": {"type": ["integer", "null"], "minimum": 0},
        "message": {"type": "string"}
      }
    },
    "pendingFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_name", "fields", "reason"],
      "properties": {
        "feature_name": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason": {"type": "string"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_name", "field", "existing_value", "required_value", "message"],
      "properties": {
        "feature_name": {"type": "string"},
        "field": {"type": "string"},
        "existing_value": {},
        "required_value": {},
        "message": {"type": "string"}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_name", "data_value", "data_type", "default_value", "required"],
      "properties": {
        "raw_name": {"type": "string"},
        "data_value": {"type": ["number", "string"]},
        "data_type": {"enum": ["NUMBER", "LIST", "STRING", "BOOLEAN"]},
        "default_value": {"const": ""},
        "required": {"const": "true"}
      },
      "allOf": [
        {
          "if": {"properties": {"data_type": {"const": "NUMBER"}}},
          "then": {"properties": {"data_value": {"type": "number"}}}
        },
        {
          "if": {"properties": {"data_type": {"enum": ["LIST", "STRING", "BOOLEAN"]}}},
          "then": {"properties": {"data_value": {"type": "string"}}}
        }
      ]
    },
    "addition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_name", "feature_kind", "properties"],
      "properties": {
        "feature_name": {"type": "string"},
        "feature_kind": {"enum": ["BASE", "DERIVED"]},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}}
      }
    },
    "syntaxStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "original_input", "normalized_input", "audit", "issues"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "PENDING"]},
        "message": {"type": "string"},
        "original_input": {"$ref": "#/$defs/nullableString"},
        "normalized_input": {"$ref": "#/$defs/nullableString"},
        "audit": {"type": "array", "items": {"type": "string"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PENDING"}}},
          "then": {"properties": {"original_input": {"type": "null"}, "normalized_input": {"type": "null"}, "audit": {"maxItems": 0}, "issues": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "PASS"}}},
          "then": {"properties": {"original_input": {"type": "string", "minLength": 1}, "normalized_input": {"type": "string", "minLength": 1}, "issues": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "FAIL"}}},
          "then": {"properties": {"original_input": {"type": "string", "minLength": 1}, "normalized_input": {"type": "string", "minLength": 1}, "issues": {"minItems": 1}}}
        }
      ]
    },
    "discoveryStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "base_references", "issues"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "message": {"type": "string"},
        "base_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "completionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "pending_facts", "conflicts", "additions"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "message": {"type": "string"},
        "pending_facts": {"type": "array", "items": {"$ref": "#/$defs/pendingFact"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "additions": {"type": "array", "items": {"$ref": "#/$defs/addition"}}
      }
    },
    "validationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "mode", "target_feature", "reachable_features", "issues"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "message": {"type": "string"},
        "mode": {"enum": ["NOT_RUN", "REMOTE", "RULE_FALLBACK"]},
        "target_feature": {"$ref": "#/$defs/nullableString"},
        "reachable_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "NOT_RUN"}}},
          "then": {"properties": {"status": {"const": "SKIPPED"}, "target_feature": {"type": "null"}, "reachable_features": {"maxItems": 0}, "issues": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["REMOTE", "RULE_FALLBACK"]}}},
          "then": {"properties": {"status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}, "target_feature": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "verdictStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "message", "boundary"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "INCOMPLETE", "SKIPPED"]},
        "value": {"enum": ["PASS", "FAIL", "INCOMPLETE", null]},
        "message": {"type": "string"},
        "boundary": {"enum": ["REMOTE_VALIDATOR_RESULT", "RULE_VALIDATION_ONLY", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "SKIPPED"}}},
          "then": {"properties": {"value": {"type": "null"}, "boundary": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "PASS"}}},
          "then": {"properties": {"value": {"const": "PASS"}, "boundary": {"enum": ["REMOTE_VALIDATOR_RESULT", "RULE_VALIDATION_ONLY"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "FAIL"}}},
          "then": {"properties": {"value": {"const": "FAIL"}, "boundary": {"enum": ["REMOTE_VALIDATOR_RESULT", "RULE_VALIDATION_ONLY"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "INCOMPLETE"}}},
          "then": {"properties": {"value": {"const": "INCOMPLETE"}, "boundary": {"enum": ["REMOTE_VALIDATOR_RESULT", "RULE_VALIDATION_ONLY"]}}}
        }
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax_intake", "base_discovery", "base_completion", "derived_completion", "final_validation", "verdict"],
      "properties": {
        "syntax_intake": {"$ref": "#/$defs/syntaxStage"},
        "base_discovery": {"$ref": "#/$defs/discoveryStage"},
        "base_completion": {"$ref": "#/$defs/completionStage"},
        "derived_completion": {"$ref": "#/$defs/completionStage"},
        "final_validation": {"$ref": "#/$defs/validationStage"},
        "verdict": {"$ref": "#/$defs/verdictStage"}
      }
    },
    "nextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_type", "question", "required_features", "required_fields", "expected_input_format"],
      "properties": {
        "request_type": {
          "enum": ["EXPRESSION_INPUT", "SYNTAX_CORRECTION", "CONFLICT_CORRECTION", "BASE_METADATA", "DERIVED_NAME", "OPERATOR_CONTRACT", "DERIVED_METADATA", "MODEL_CORRECTION", "MODEL_WRAPPER", "NONE"]
        },
        "question": {
          "enum": [
            "请按 expected_input_format 提供一个完整的特征表达式。",
            "请修正表达式语法后重新提交完整表达式；系统不会自动补写或修复。",
            "请业务人工修正 conflicts 中的冲突，并按 expected_input_format 返回修正后的特征配置。",
            "请按 expected_input_format 提供 required_features 中 BASE 特征的当前配置。",
            "请提供当前表达式对应的 DERIVED 特征名称。",
            "请提供缺失算子的语义契约，或直接确认 DERIVED 输出字段。",
            "请按 pending_facts 确认 DERIVED 特征中无法由算子契约确定的字段。",
            "请按 issues 修正模型并应用 additions（如有），然后按 expected_input_format 重新提交 target_feature 与完整模型包装。",
            "请提供 target_feature 以及完整的 feature_set_name、version、features 模型包装。",
            "无需补充信息。"
          ]
        },
        "required_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expected_input_format": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"request_type": {"const": "EXPRESSION_INPUT"}}},
          "then": {"properties": {
            "question": {"const": "请按 expected_input_format 提供一个完整的特征表达式。"},
            "required_features": {"maxItems": 0},
            "required_fields": {"maxItems": 0},
            "expected_input_format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expression"],
              "properties": {"expression": {"const": "..."}}
            }
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "SYNTAX_CORRECTION"}}},
          "then": {"properties": {
            "question": {"const": "请修正表达式语法后重新提交完整表达式；系统不会自动补写或修复。"},
            "expected_input_format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expression"],
              "properties": {"expression": {"const": "..."}}
            }
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "CONFLICT_CORRECTION"}}},
          "then": {"properties": {
            "question": {"const": "请业务人工修正 conflicts 中的冲突，并按 expected_input_format 返回修正后的特征配置。"},
            "expected_input_format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["features"],
              "properties": {"features": {"type": "array", "maxItems": 0}}
            }
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "BASE_METADATA"}}},
          "then": {"properties": {
            "question": {"const": "请按 expected_input_format 提供 required_features 中 BASE 特征的当前配置。"},
            "expected_input_format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["features"],
              "properties": {"features": {"type": "array", "maxItems": 0}}
            }
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "DERIVED_NAME"}}},
          "then": {"properties": {
            "question": {"const": "请提供当前表达式对应的 DERIVED 特征名称。"},
            "expected_input_format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["derived_feature_name"],
              "properties": {"derived_feature_name": {"const": "..."}}
            }
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "OPERATOR_CONTRACT"}}},
          "then": {"properties": {
            "question": {"const": "请提供缺失算子的语义契约，或直接确认 DERIVED 输出字段。"},
            "expected_input_format": {"$ref": "#/$defs/derivedFactsInput"}
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "DERIVED_METADATA"}}},
          "then": {"properties": {
            "question": {"const": "请按 pending_facts 确认 DERIVED 特征中无法由算子契约确定的字段。"},
            "expected_input_format": {"$ref": "#/$defs/derivedFactsInput"}
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "MODEL_CORRECTION"}}},
          "then": {"properties": {
            "question": {"const": "请按 issues 修正模型并应用 additions（如有），然后按 expected_input_format 重新提交 target_feature 与完整模型包装。"},
            "expected_input_format": {"$ref": "#/$defs/modelCorrectionInput"}
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "MODEL_WRAPPER"}}},
          "then": {"properties": {
            "question": {"const": "请提供 target_feature 以及完整的 feature_set_name、version、features 模型包装。"},
            "required_features": {"maxItems": 0},
            "required_fields": {"maxItems": 0},
            "expected_input_format": {"$ref": "#/$defs/modelWrapperInput"}
          }}
        },
        {
          "if": {"properties": {"request_type": {"const": "NONE"}}},
          "then": {"properties": {
            "question": {"const": "无需补充信息。"},
            "required_features": {"maxItems": 0},
            "required_fields": {"maxItems": 0},
            "expected_input_format": {"maxProperties": 0}
          }}
        }
      ]
    },
    "derivedFactsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_name", "fields"],
      "properties": {
        "feature_name": {"type": "string"},
        "fields": {"type": "object", "maxProperties": 0}
      }
    },
    "modelWrapperInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_feature", "feature_set"],
      "properties": {
        "target_feature": {"type": "string"},
        "feature_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_set_name", "version", "features"],
          "properties": {
            "feature_set_name": {"const": "..."},
            "version": {"const": "..."},
            "features": {"type": "array", "maxItems": 0}
          }
        }
      }
    },
    "modelCorrectionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_feature", "feature_set"],
      "properties": {
        "target_feature": {"type": "string", "minLength": 1},
        "feature_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_set_name", "version", "features"],
          "properties": {
            "feature_set_name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "features": {"type": "array", "maxItems": 0}
          }
        }
      }
    }
  }
}
