{
  "feature_set_name": "advertising_fatigue_golden_cases",
  "version": "1.0",
  "features": [
    {
      "name": "candidate_ad_industry",
      "raw_name": "candidate_ad_industry",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 1,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "本次参与排序的候选广告行业"
    },
    {
      "name": "recent_ad_industry_seq",
      "raw_name": "recent_ad_industry_seq",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 2,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "用户近期接触过的广告行业序列"
    },
    {
      "name": "recent_ad_action_seq",
      "raw_name": "recent_ad_action_seq",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 3,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "与广告行业逐位置对齐的 expose、click、convert 等行为"
    },
    {
      "name": "candidate_score_component_seq",
      "raw_name": "candidate_score_component_seq",
      "type": "DOUBLE",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 4,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 16,
      "description": "候选广告的 CTR、CVR、出价等待校正分数组件"
    },
    {
      "name": "same_industry_positions",
      "store_name": "same_industry_positions",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "find_indices(recent_ad_industry_seq, candidate_ad_industry)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 101,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "候选广告行业在近期广告行为中的位置"
    },
    {
      "name": "same_industry_ads",
      "store_name": "same_industry_ads",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "slice_by_indices(recent_ad_industry_seq, same_industry_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 102,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "按匹配位置截取出的同业广告行业"
    },
    {
      "name": "same_industry_actions",
      "store_name": "same_industry_actions",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "slice_by_indices(recent_ad_action_seq, same_industry_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 103,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "按匹配位置截取出的同业广告行为"
    },
    {
      "name": "same_industry_action_tokens",
      "store_name": "same_industry_action_tokens",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "zip_concat(same_industry_ads, same_industry_actions, {\"delimiter\":\"|\"})",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 104,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 128,
      "description": "行业和行为组合，例如 GAME|click"
    },
    {
      "name": "distinct_same_industry_action_count",
      "store_name": "distinct_same_industry_action_count",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "count_distinct(same_industry_action_tokens)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 105,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "同业广告历史行为类型的丰富度"
    },
    {
      "name": "same_industry_event_count",
      "store_name": "same_industry_event_count",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "get_seq_length(same_industry_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 106,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "候选广告行业的近期触达次数"
    },
    {
      "name": "ad_fatigue_bucket",
      "store_name": "ad_fatigue_bucket",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "discrete(same_industry_event_count, [0, 1, 3, 5])",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 107,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "按同业广告触达次数生成的疲劳度桶"
    },
    {
      "name": "ad_fatigue_log2",
      "store_name": "ad_fatigue_log2",
      "type": "DOUBLE",
      "definition_type": "DERIVED",
      "expression": "log_base(ad_fatigue_bucket, 2, 16)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 108,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "平滑后的广告疲劳惩罚值"
    },
    {
      "name": "fatigue_adjusted_score_components",
      "store_name": "fatigue_adjusted_score_components",
      "type": "DOUBLE",
      "definition_type": "DERIVED",
      "expression": "calc_delta_seq(candidate_score_component_seq, ad_fatigue_log2, {\"direction\":\"ELEMENT_MINUS_BASE\"})",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 109,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 16,
      "description": "扣除同业广告疲劳惩罚后的候选广告分数组件"
    }
  ]
}
