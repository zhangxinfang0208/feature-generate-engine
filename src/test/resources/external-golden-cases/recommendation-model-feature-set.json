{
  "feature_set_name": "recommendation_context_golden_cases",
  "version": "1.0",
  "features": [
    {
      "name": "current_category",
      "raw_name": "current_category",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 1,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "当前请求内容类目"
    },
    {
      "name": "history_category_seq",
      "raw_name": "history_category_seq",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 2,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "用户历史行为对应的内容类目序列"
    },
    {
      "name": "history_action_seq",
      "raw_name": "history_action_seq",
      "type": "STRING",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 3,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "与历史类目逐位置对齐的行为类型序列"
    },
    {
      "name": "history_score_seq",
      "raw_name": "history_score_seq",
      "type": "DOUBLE",
      "definition_type": "BASE",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 4,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "待按匹配强度中心化的历史分数序列"
    },
    {
      "name": "matched_positions",
      "store_name": "matched_positions",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "find_indices(history_category_seq, current_category)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 101,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "当前类目在历史行为中的全部位置"
    },
    {
      "name": "matched_categories",
      "store_name": "matched_categories",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "slice_by_indices(history_category_seq, matched_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 102,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "按匹配位置截取出的历史类目"
    },
    {
      "name": "matched_actions",
      "store_name": "matched_actions",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "slice_by_indices(history_action_seq, matched_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 103,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "按匹配位置截取出的行为类型"
    },
    {
      "name": "matched_category_actions",
      "store_name": "matched_category_actions",
      "type": "STRING",
      "definition_type": "DERIVED",
      "expression": "zip_concat(matched_categories, matched_actions, {\"delimiter\":\"|\"})",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 104,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "逐位置拼接的类目和行为上下文"
    },
    {
      "name": "distinct_matched_context_count",
      "store_name": "distinct_matched_context_count",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "count_distinct(matched_category_actions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 105,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "去重后的类目行为组合数"
    },
    {
      "name": "matched_event_count",
      "store_name": "matched_event_count",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "get_seq_length(matched_positions)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 106,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "当前类目的历史匹配次数"
    },
    {
      "name": "matched_event_bucket",
      "store_name": "matched_event_bucket",
      "type": "INT",
      "definition_type": "DERIVED",
      "expression": "discrete(matched_event_count, [0, 1, 3, 5])",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 107,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "按 0、1、3、5 次边界离散后的匹配强度"
    },
    {
      "name": "matched_event_log2",
      "store_name": "matched_event_log2",
      "type": "DOUBLE",
      "definition_type": "DERIVED",
      "expression": "log_base(matched_event_bucket, 2, 16)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 108,
      "entity_scopes": ["USER"],
      "value_shape": "SCALAR",
      "seq_max_length": 1,
      "description": "匹配强度的以 2 为底对数"
    },
    {
      "name": "normalized_score_seq",
      "store_name": "normalized_score_seq",
      "type": "DOUBLE",
      "definition_type": "DERIVED",
      "expression": "calc_delta_seq(history_score_seq, matched_event_log2)",
      "output_policy": "OUTPUT",
      "to_use": true,
      "order": 109,
      "entity_scopes": ["USER"],
      "value_shape": "SEQUENCE",
      "seq_max_length": 64,
      "description": "每个历史分数减去匹配强度对数后的序列"
    }
  ]
}
